# 在等号右侧填写配置值，保存后重启程序。
# 每行一项；可选项不用时留空。

# 大模型：填写同一服务商的 Key、接口地址和模型名称。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# 高德地图：分别填写 Web 服务 Key 和 Web 端（JS API）Key。
AMAP_API_KEY=
AMAP_SIGN_SECRET=
AMAP_WEB_KEY=
AMAP_JS_SEC=

# 和风天气（可选）：两项都填写时使用和风，否则使用高德天气。
# Host 只填控制台分配的域名，不带 https:// 或路径。
QWEATHER_API_KEY=
QWEATHER_API_HOST=

# 联网出行参考（可选）：使用 DeepSeek 搜索／抓取 Key。
# 上方使用官方 DeepSeek 接口时可留空，复用 LLM_API_KEY。
GUIDE_SEARCH_API_KEY=
GUIDE_OFFICIAL_DOMAINS=

# 以下选项通常保持默认即可。
PORT=7862
AMAP_QPS=2
RAIL_MCP_ENABLED=true
RAIL_MCP_PYTHON=
STUDY_CORPUS_DIR=.runtime/study/shanghai_youth_v1
RAG_RETRIEVAL_MODE=auto
