# Copy to .env.local; never commit real credentials.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
AMAP_API_KEY=
AMAP_WEB_KEY=
AMAP_JS_SEC=
AMAP_SIGN_SECRET=
# Shared pacing per REST endpoint in this server process; tune to account limits.
AMAP_QPS=2
# auto: use Cangjie only after its local parity check passes; otherwise Python.
VALIDATOR_BACKEND=auto
PORT=7862
# Bundled third_party/mcp-server-12306; setup installs its isolated dependencies.
RAIL_MCP_ENABLED=true
RAIL_MCP_PYTHON=
